# Copie este arquivo para ".env" e ajuste os valores. O ".env" NUNCA deve ir para o Git.

# Porta da API (o frontend usa http://localhost:3001/api por padrão)
PORT=3001

# Segredo usado para assinar os tokens de login (JWT). Use um texto longo e aleatório.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Origens do frontend autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Fuso horário usado nas datas e horas gravadas (auditoria, saídas, notas)
TZ=America/Sao_Paulo

# Pasta onde ficam as fotos das notas fiscais (padrão: ./uploads/notas)
# UPLOAD_DIR=
